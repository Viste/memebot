# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL=@your_channel_here

# User Management
BANNED_USER_IDS=123456789,987654321
ADMIN_USER_IDS=111111111,222222222

# Database Configuration
DATABASE_URL=postgres://meme_user:meme_password@localhost:5432/meme_bot?sslmode=disable

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://31.172.78.152:9000/v1 (proxy for RU https://github.com/Viste/openai-scf-proxy)
OPENAI_MODEL=gpt-5.6-terra

# Image Generation
IMAGE_MODEL=gpt-image-2
MEME_IMAGE_PROBABILITY=0.02
CHANNEL_MEMES_PER_DAY=2

# Шанс (0..1), что Сталин вплетёт в комментарий статью УК РСФСР, если мем даёт повод
CRIMINAL_CODE_PROBABILITY=0.5

# Server Configuration
PORT=8080
